import {
  mockMeProfile,
  mockRecommendUsers,
  mockSquareUsers,
  mockUserDetail
} from './user.uts'
import {
  mockCustomMatchmakers,
  mockServiceMatchmakers
} from './matchmaker.uts'

const ordinaryProfile = mockMeProfile as any
const childBirthYear = new Date().getFullYear() - Number(ordinaryProfile.age != null ? ordinaryProfile.age : 29)

/**
 * 单子女上下文仅用于隔离的本地父母主体；生产发布仍须由服务端返回父母端专用的隐私字段。
 */
export const mockParentContext = {
	id: 'parent_context_001',
	mode: 'parent',
	dataMode: 'mock',
	parent: {
		id: 9101,
		name: String(ordinaryProfile.name) + '的家人',
		avatar: ordinaryProfile.avatar != null ? String(ordinaryProfile.avatar) : '',
		realNameStatus: 'passed'
	},
	child: {
		id: 9201,
		displayName: ordinaryProfile.name != null ? String(ordinaryProfile.name) : '我的子女',
		birthYear: childBirthYear,
		city: ordinaryProfile.city != null ? String(ordinaryProfile.city) : '南京',
		job: ordinaryProfile.job != null ? String(ordinaryProfile.job) : '产品经理',
		introduction: ordinaryProfile.introduction != null ? String(ordinaryProfile.introduction) : '认真经营生活，也期待稳定长久的关系。',
		authorizationStatus: 'granted',
		authorizationExpiresAt: '2099-12-31T23:59:59+08:00',
		profileProgress: Number(ordinaryProfile.profileProgress != null ? ordinaryProfile.profileProgress : 78)
	},
	quota: {
		dailyTotal: 3,
		remainingApplications: 2
	},
	releaseGate: {
		productionReady: false,
		code: 'PARENT_RELATIONSHIP_BACKEND_REQUIRED',
		message: '父母端服务正在持续完善。'
	}
}

function cloneChild(child: any): any {
	if (child == null) return null
	return {
		id: child.id,
		displayName: child.displayName,
		birthYear: child.birthYear,
		city: child.city,
		job: child.job,
		introduction: child.introduction,
		authorizationStatus: child.authorizationStatus,
		authorizationExpiresAt: child.authorizationExpiresAt,
		profileProgress: child.profileProgress
	}
}

export function getMockParentContextData(): any {
	return {
		id: mockParentContext.id,
		mode: mockParentContext.mode,
		dataMode: mockParentContext.dataMode,
		parent: { ...mockParentContext.parent },
		child: cloneChild(mockParentContext.child),
		quota: { ...mockParentContext.quota },
		releaseGate: { ...mockParentContext.releaseGate }
	}
}

export function updateMockParentChildProfileData(profile: any): any {
	const child = mockParentContext.child
	child.displayName = profile.displayName
	child.birthYear = profile.birthYear
	child.city = profile.city
	child.job = profile.job
	child.introduction = profile.introduction
	let progress = 60
	if (profile.job.length > 0) progress += 20
	if (profile.introduction.length > 0) progress += 20
	child.profileProgress = progress
	return cloneChild(child)
}

export function syncMockParentRemainingApplicationsData(remainingApplications: number): number {
  const total = Math.max(0, Number(mockParentContext.quota.dailyTotal))
  const remaining = Math.min(total, Math.max(0, Number(remainingApplications)))
  mockParentContext.quota.remainingApplications = remaining
  return remaining
}

/**
 * 父母端候选数据必须留在父母专用 Mock 适配层，不能通过普通用户 API 的
 * “内部 Mock 参数”绕过当前登录主体。真实父母关系服务可用前，这里只供
 * PARENT_USE_MOCK 的隔离演示路径使用。
 */
const parentLikedCandidateIds: number[] = [2]
const parentApplicationStates: any = {}

function cloneParentValue(value: any): any {
  if (value == null || typeof value !== 'object') return value
  if (Array.isArray(value)) {
    const values: any[] = []
    for (let index = 0; index < value.length; index++) values.push(cloneParentValue(value[index]))
    return values
  }
  const cloned: any = {}
  const keys = Object.keys(value)
  for (let index = 0; index < keys.length; index++) {
    const key = keys[index]
    cloned[key] = cloneParentValue(value[key])
  }
  return cloned
}

function parentCandidateSource(): any[] {
  const source: any[] = []
  const lists = [mockRecommendUsers as any[], mockSquareUsers as any[]]
  for (let listIndex = 0; listIndex < lists.length; listIndex++) {
    const list = lists[listIndex]
    for (let itemIndex = 0; itemIndex < list.length; itemIndex++) {
      const item = list[itemIndex]
      const id = item != null && item.id != null ? Number(item.id) : 0
      if (!Number.isFinite(id) || id <= 0) continue
      let known = false
      for (let existingIndex = 0; existingIndex < source.length; existingIndex++) {
        if (Number(source[existingIndex].id) == id) {
          known = true
          break
        }
      }
      if (!known) source.push(item)
    }
  }
  return source
}

function isParentCandidateLiked(candidateId: number): boolean {
  for (let index = 0; index < parentLikedCandidateIds.length; index++) {
    if (parentLikedCandidateIds[index] == candidateId) return true
  }
  return false
}

export function getMockParentCandidatesData(): any[] {
  const rows: any[] = []
  const source = parentCandidateSource()
  for (let index = 0; index < source.length; index++) {
    const item = cloneParentValue(source[index])
    item.liked = isParentCandidateLiked(Number(item.id))
    rows.push(item)
  }
  return rows
}

export function getMockParentLikedCandidatesData(): any[] {
  return getMockParentCandidatesData().filter((item: any) => item.liked == true)
}

export function getMockParentCandidateDetailData(candidateId: number): any | null {
  const source = parentCandidateSource()
  let candidate: any = null
  for (let index = 0; index < source.length; index++) {
    if (Number(source[index].id) == candidateId) {
      candidate = source[index]
      break
    }
  }
  if (candidate == null) return null
  const detail = cloneParentValue(mockUserDetail)
  const candidateCopy = cloneParentValue(candidate)
  const introduction = candidateCopy.intro != null
    ? String(candidateCopy.intro)
    : (candidateCopy.introduction != null ? String(candidateCopy.introduction) : String(detail.introduction != null ? detail.introduction : ''))
  return {
    ...detail,
    ...candidateCopy,
    introduction: introduction,
    genderText: Number(candidateCopy.gender) == 1 ? '男' : '女',
    certList: ['实名', '学历', '头像', '单身'],
    liked: isParentCandidateLiked(candidateId)
  }
}

export function toggleMockParentLikeData(candidateId: number): any {
  let index = -1
  for (let itemIndex = 0; itemIndex < parentLikedCandidateIds.length; itemIndex++) {
    if (parentLikedCandidateIds[itemIndex] == candidateId) {
      index = itemIndex
      break
    }
  }
  const liked = index < 0
  if (liked) parentLikedCandidateIds.push(candidateId)
  else parentLikedCandidateIds.splice(index, 1)
  return { success: true, liked: liked, userId: candidateId, internalDemo: true }
}

export function submitMockParentIntroductionData(
  candidateId: number,
  remainingApplications: number
): any {
  const key = String(candidateId)
  if (parentApplicationStates[key] == 'pending') {
    return {
      success: false,
      data: { success: false, applyStatus: 'pending', remainingApplications: remainingApplications },
      code: 'ALREADY_PENDING',
      message: '申请已发送，请等待对方回应。'
    }
  }
  if (remainingApplications <= 0) {
    return {
      success: false,
      data: { success: false, applyStatus: 'none', remainingApplications: 0 },
      code: 'QUOTA_EXCEEDED',
      message: '今日申请次数已用完。'
    }
  }
  parentApplicationStates[key] = 'pending'
  const nextRemaining = Math.max(0, remainingApplications - 1)
  syncMockParentRemainingApplicationsData(nextRemaining)
  return {
    success: true,
    data: {
      success: true,
      applyStatus: 'pending',
      remainingApplications: nextRemaining,
      internalDemo: true,
      message: '申请已送达，等待对方回应。'
    },
    code: 0,
    message: 'success'
  }
}

export function getMockParentMatchmakersData(kind: 'service' | 'custom'): any[] {
  const source = kind == 'service' ? (mockServiceMatchmakers as any[]) : (mockCustomMatchmakers as any[])
  const rows: any[] = []
  for (let index = 0; index < source.length; index++) rows.push(cloneParentValue(source[index]))
  return rows
}
